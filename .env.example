# Set these as environment variables or deployment secrets. Never commit real values.
APP_SECRET_KEY=            # required, 32+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./dev.db        # production: postgresql://user:password@host:5432/dbname
LLM_PROVIDER=              # set to: anthropic
ANTHROPIC_API_KEY=         # your provider key, server side only
LLM_MODEL=claude-sonnet-5-5
TOKEN_MINUTES=60
APPROVAL_HOURS=48
MAX_ACTIONS_PER_DAY=20
CORS_ORIGINS=              # comma separated, e.g. http://localhost:5173
ALLOW_PRIVATE_URLS=false   # keep false in production (SSRF protection)
LOGIN_MAX_FAILURES=5       # failed sign-ins per email before a lock
LOGIN_WINDOW_MINUTES=15    # lock length and counting window
AI_MONTHLY_LIMIT=200       # AI requests per workspace per month
MAX_BODY_BYTES=1000000     # largest request body accepted
LLM_PRICE_INPUT_PER_MTOK=   # optional, for the cost ESTIMATE (your provider's price per million input tokens)
LLM_PRICE_OUTPUT_PER_MTOK=  # optional, per million output tokens
LLM_PRICE_CURRENCY=USD
POSTGRES_PASSWORD=          # used only by docker-compose.yml

# --- AI providers (set only the ones you use; values stay on the server) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=          (already used above)
# Optional cost estimates (USD per million tokens), from your provider's price list:
# AI_PRICES={"openai:your-model-id": {"in": 0, "out": 0}}
